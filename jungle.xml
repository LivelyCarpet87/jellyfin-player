<project xmlns="http://www.garmin.com/xml/connectiq/jungle">
    <projectName>JellyfinWatchPlayer</projectName>
    <projectType>application</projectType>
    <targetMinSdkVersion>4.0</targetMinSdkVersion>

    <!-- Manifest file -->
    <manifestFile>manifest.xml</manifestFile>

    <!-- Source folders -->
    <sourceFolders>
        <sourceFolder>source</sourceFolder>
    </sourceFolders>

    <!-- Resource folders -->
    <resourceFolders>
        <resourceFolder>resources</resourceFolder>
    </resourceFolders>

    <!-- Output directory for compiled .prg -->
    <outputFolder>build</outputFolder>

    <!-- Build configuration -->
    <buildConfig>
        <compiler>monkeyc</compiler>
        <buildTarget>fenix7</buildTarget> <!-- example target; adjust for your watch -->
        <optimize>true</optimize>
        <verbose>false</verbose>
    </buildConfig>

    <!-- SDK path (optional if using CONNECT_IQ environment variable) -->
    <!-- <sdkPath>/path/to/connectiq-sdk</sdkPath> -->
</project>